#!/bin/sh
# Launch the KaidoPlan MCP server (stdio). Resolution order: KAIDOPLAN_MCP_BIN,
# then this checkout's build products, then PATH (Homebrew install).
set -eu

if [ -n "${KAIDOPLAN_MCP_BIN:-}" ]; then
  exec "$KAIDOPLAN_MCP_BIN"
fi

root="$(CDPATH= cd -- "$(dirname -- "$0")/../../.." && pwd)"
for candidate in "$root/.build/release/KaidoPlanMCP" "$root/.build/debug/KaidoPlanMCP"; do
  if [ -x "$candidate" ]; then
    exec "$candidate"
  fi
done

# The standalone plugin repo (kaidoplan-plugin) has no .build directory, so fall
# back to the binary on PATH. Our own path is skipped: if the plugin's bin
# directory is on PATH, exec-ing it would loop forever.
self_dir="$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)"
self="$self_dir/$(basename -- "$0")"
for name in kaidoplan-mcp KaidoPlanMCP; do
  resolved="$(command -v "$name" 2>/dev/null || true)"
  if [ -z "$resolved" ]; then continue; fi
  if ! resolved_dir="$(CDPATH= cd -- "$(dirname -- "$resolved")" 2>/dev/null && pwd)"; then continue; fi
  resolved="$resolved_dir/$(basename -- "$resolved")"
  if [ "$resolved" = "$self" ]; then continue; fi
  if [ -x "$resolved" ]; then
    exec "$resolved"
  fi
done

echo "kaidoplan-mcp: KaidoPlanMCP not found. Run 'swift build -c release', install the CLI via Homebrew, or set KAIDOPLAN_MCP_BIN." >&2
exit 1
